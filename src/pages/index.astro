---
// You can write JavaScript/TypeScript here if needed for build-time logic
// For a simple landing page, this might be empty.
import BaseLayout from "../layouts/BaseLayout.astro"; // Example: Using a layout
const pageTitle = "Vaani Audiobook App";
---

<BaseLayout title={pageTitle}>
  <h1>Welcome to {pageTitle}!</h1>
  <p>Listen to your audiobooks seamlessly.</p>

  <section id="features">
    <h2>Features</h2>
    <ul>
      <li>Feature 1...</li>
      <li>Feature 2...</li>
    </ul>
  </section>

  <section id="download">
    <h2>Download</h2>
    <a href="#">Download for Android</a>
    <a href="#">Download for iOS (Coming Soon!)</a>
  </section>

  <section id="github">
    <h2>Open Source</h2>
    <a href="https://github.com/Dr-Blank/Vaani" target="_blank" rel="noopener noreferrer"
      >View on GitHub</a
    >
  </section>
</BaseLayout>
