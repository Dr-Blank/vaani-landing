---
// 1. Import necessary components
import Layout from "~/layouts/PageLayout.astro"; // Using PageLayout for standard page structure
import Hero from "~/components/widgets/Hero.astro";
import Note from "~/components/widgets/Note.astro"; // Simple widget for the notice
import Content from "~/components/widgets/Content.astro"; // Good for showcasing features with images
import CallToAction from "~/components/widgets/CallToAction.astro";
import { getAsset } from "~/utils/permalinks"; // Helper for asset paths if needed
import type { Hero as HeroType } from "~/types";

import Button from "~/components/ui/Button.astro";
import Image from "~/components/common/Image.astro";
import { SITE, METADATA, I18N } from "astrowind:config";

const googlePlayImg = "~/assets/images/google-play.png";
const googlePlayDownloadLink =
  "https://play.google.com/store/apps/details?id=dr.blank.vaani";
const izzyOnDroidImg = "~/assets/images/IzzyOnDroid.png";
const izzyOnDroidDownloadLink =
  "https://apt.izzysoft.de/fdroid/repo/dr.blank.vaani";
const obtainiumImg = "~/assets/images/badge_obtainium.png";
const obtainiumDownloadLink =
  "http://apps.obtainium.imranr.dev/redirect.html?r=obtainium://add/https://github.com/Dr-Blank/Vaani";

// 3. Define Data for Widgets

// HERO SECTION DATA
const heroData: HeroType = {
  title: "Vaani: Your Beautiful & Fast Audiobookshelf Client",
  subtitle:
    "Enjoy your self-hosted audiobooks on the go with a feature-rich Android client focused on speed, function, and Material Design.",
  actions: [
    {
      variant: "primary", // Main download button
      text: "Get it on Google Play",
      href: "https://play.google.com/store/apps/details?id=dr.blank.vaani&hl=en_IN", // YOUR PLAY STORE LINK
      target: "_blank",
      icon: "tabler:brand-google-play",
    },
    {
      // Secondary download option
      text: "Get from IzzyOnDroid",
      href: "https://apt.izzysoft.de/fdroid/repo/dr.blank.vaani", // CONFIRM YOUR IZZY LINK
      target: "_blank",
      icon: "tabler:download",
    },
    {
      // Third download option
      text: "GitHub / Obtainium",
      href: "https://github.com/Dr-Blank/Vaani/releases", // Link to releases page
      target: "_blank",
      icon: "tabler:brand-github",
    },
  ],
  image: {
    // Use your best mockup - assuming player screen is good here
    // ** IMPORTANT: Replace 'home.jpg' with your actual main mockup filename **
    src: "~/assets/images/mockups/home.jpg", // e.g., '~/assets/images/mockups/mockup-player.png'
    alt: "Vaani App Screenshot - Player",
  },
};

// FEATURES SECTION DATA (using multiple Content widgets)
// ** IMPORTANT: Update mockup filenames and alt text for each feature **
const feature1Data = {
  id: "features", // ID for navigation link
  isReversed: false, // Image on right
  tagline: "Player Features",
  title: "Full Playback Control",
  items: [
    {
      title: "Variable Speed",
      description: "Listen at your own pace, from 0.5x to 3.0x speed.",
    },
    {
      title: "Sleep Timer",
      description: "Drift off to your story without draining your battery.",
    },
    {
      title: "Shake to Control",
      description:
        "(Optional) Configure shake gestures for common player actions.",
    },
  ],
  image: {
    src: "~/assets/images/mockups/mockup-player.jpg", // PATH TO YOUR PLAYER MOCKUP
    alt: "Vaani Playback Controls Mockup",
  },
};

const feature2Data = {
  isReversed: true, // Image on left
  tagline: "Library & Sync",
  title: "Offline Listening & Caching",
  items: [
    {
      title: "Download for Offline",
      description:
        "Save audiobooks directly to your device for listening anywhere, without using mobile data.",
    },
    {
      title: "Smart Caching",
      description:
        "Efficiently caches streamed content to reduce data usage and improve loading times.",
    },
    {
      title: "Seamless Sync",
      description:
        "Keeps your progress and library synchronized with your Audiobookshelf server.",
    },
  ],
  image: {
    src: "~/assets/images/mockups/bookview.jpg", // PATH TO YOUR OFFLINE/LIBRARY MOCKUP
    alt: "Vaani Offline Library Mockup",
  },
};

const feature3Data = {
  isReversed: false, // Image on right
  tagline: "Design & Customization",
  title: "Material Design & Deep Settings",
  items: [
    {
      title: "Clean Material You Interface",
      description:
        "Enjoy a modern, intuitive Android experience following the latest Material Design guidelines.",
    },
    {
      title: "Extensive Settings",
      description:
        "Tailor nearly every aspect of the player and library behaviour to your exact preferences.",
    },
    {
      title: "Theme Options",
      description: "Supports light, dark, and system default themes.",
    },
  ],
  image: {
    src: "~/assets/images/mockups/mockup-settings.png", // PATH TO YOUR SETTINGS/DESIGN MOCKUP
    alt: "Vaani Settings Screen Mockup",
  },
};

// (Optional) OPEN SOURCE INFO - Can use Content or Note widget
const openSourceData = {
  isAfterContent: true, // Use this variation of Content for a centered feel maybe? Or use Note.
  title: "Open Source & Community",
  // Using 'items' in Content widget for bullet points
  items: [
    {
      title: "Free & Open Source",
      description:
        "Vaani is licensed under AGPL-3.0-only. View, modify, and contribute to the code freely.",
      icon: "tabler:brand-github",
    },
    {
      title: "Community Driven",
      description:
        "Report issues, suggest features, or contribute directly on our GitHub repository.",
      icon: "tabler:message-circle",
    },
  ],
  // Or using Note widget for simpler text:
  // description: 'Vaani is proudly Free and Open Source Software (AGPLv3). Contributions and feedback are welcome on [GitHub](https://github.com/Dr-Blank/Vaani)!',
};
---

<Layout>
  <!-- Hero Section -->
  <Hero {...heroData}>
    <!-- Use default slots from heroData, or override title/subtitle here if needed -->
    <Fragment slot="title">
      {heroData.title}
    </Fragment>
    <Fragment slot="subtitle">
      {heroData.subtitle}
    </Fragment>
  </Hero>

  <!-- Requires Audiobookshelf Notice -->
  <!-- Adding some top/bottom margin for spacing -->
  <div class="py-4 md:py-6">
    <Note
      title="Note:"
      description='Vaani is a client application and <strong>requires a working <a href="https://www.audiobookshelf.org/" target="_blank" rel="noopener noreferrer" class="underline">Audiobookshelf server</a></strong> to function. It does not manage audio files directly.'
    />
  </div>

  <!-- Features Section (using multiple Content widgets) -->
  <Content {...feature1Data} />
  <Content {...feature2Data} />
  <Content {...feature3Data} />
  <!-- Add more Content widgets if you have more features with mockups -->

  <!-- Optional: Open Source Section -->
  <Content {...openSourceData}>
    <Fragment slot="bg">
      <!-- Optional subtle background for this section -->
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-800/50"></div>
    </Fragment>
  </Content>

  <!-- Call to Action / Final Download Section -->
  <CallToAction
    id="download"
    title="Ready to Listen?"
    subtitle="Download Vaani today and connect to your Audiobookshelf server. It's open source and free!"
  >
    <div slot="actions" class="flex gap-4">
      <Button variant="link" href={googlePlayDownloadLink} target="_blank">
        <Image src={googlePlayImg} alt="Google Play Image" width={200} />
      </Button>

      <Button variant="link" href={izzyOnDroidDownloadLink} target="_blank">
        <Image src={izzyOnDroidImg} alt="IzzyOnDroid Image" width={200} />
      </Button>

      <Button variant="link" href={obtainiumDownloadLink} target="_blank">
        <Image src={obtainiumImg} alt="Obtainium Image" width={200} />
      </Button>
    </div>

    <!-- Remove all other default widgets -->
  </CallToAction>
</Layout>
