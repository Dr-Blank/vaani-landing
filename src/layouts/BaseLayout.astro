---
// src/layouts/BaseLayout.astro
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="/global.css" />
    {/* Link global styles */}
  </head>
  <body>
    <header>
      <!-- Maybe a simple nav -->
    </header>
    <main>
      <slot />
      <!-- Page content will be injected here -->
    </main>
    <footer>
      <p>© {new Date().getFullYear()} Your Name/Company</p>
      <a href="/privacy-policy">Privacy Policy</a>
    </footer>
  </body>
</html>
<style is:global>
  /* You can add some basic global styles here or link an external sheet */
  body {
    font-family: sans-serif;
    margin: 0;
  }
  main {
    padding: 1rem;
    max-width: 800px;
    margin: auto;
  }
  footer {
    text-align: center;
    margin-top: 2rem;
    padding: 1rem;
    background-color: #f0f0f0;
  }
</style>
